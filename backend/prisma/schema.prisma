generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  runtime                = "nodejs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

enum OAuthProvider {
  GOOGLE
}

enum SellerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductType {
  FIXED_PRICE
  AUCTION
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum OrderStatus {
  NEW
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  PARTIALLY_COMPLETED
  COMPLETED
  PARTIALLY_CANCELLED
  CANCELLED
}

enum SellerOrderStatus {
  NEW
  PROCESSING
  SHIPPED
  COMPLETED
  PARTIALLY_CANCELLED
  CANCELLED
}

enum LedgerAccount {
  PLATFORM
  SELLER
}

enum LedgerEntryType {
  COMMISSION
  SELLER_EARNING
  REFUND_REVERSAL
  CANCELLATION_REVERSAL
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum CheckoutIdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum AuctionStatus {
  SCHEDULED
  ACTIVE
  ENDED
  SOLD
  UNSOLD
  CANCELLED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  CLOSED
}

model User {
  id                         String                @id @default(uuid()) @db.Uuid
  email                      String                @unique
  passwordHash               String?
  role                       UserRole              @default(CUSTOMER)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  refreshSessions            RefreshSession[]
  oauthAccounts              OAuthAccount[]
  sellerApplications         SellerApplication[]   @relation("Applicant")
  reviewedSellerApplications SellerApplication[]   @relation("ApplicationReviewer")
  sellerProfile              SellerProfile?
  moderatedProducts          Product[]             @relation("ProductModerator")
  cart                       Cart?
  orders                     Order[]
  checkoutIdempotencies      CheckoutIdempotency[]
  initiatedRefunds           Refund[]
  bids                       Bid[]
  wonAuctions                Auction[]             @relation("AuctionWinner")
  reviews                    Review[]
  disputes                   Dispute[]             @relation("DisputeCustomer")
  reviewedDisputes           Dispute[]             @relation("DisputeReviewer")
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  provider          OAuthProvider
  providerAccountId String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@index([userId])
}

model RefreshSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SellerApplication {
  id              String                  @id @default(uuid()) @db.Uuid
  userId          String                  @db.Uuid
  displayName     String
  status          SellerApplicationStatus @default(PENDING)
  reviewedById    String?                 @db.Uuid
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  user            User                    @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy      User?                   @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, status])
}

model SellerProfile {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @unique @db.Uuid
  displayName  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  products     Product[]
  sellerOrders SellerOrder[]
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id              String        @id @default(uuid()) @db.Uuid
  sellerId        String        @db.Uuid
  categoryId      String        @db.Uuid
  title           String
  description     String
  imageUrl        String?
  type            ProductType
  price           Decimal?      @db.Decimal(19, 2)
  stock           Int           @default(0)
  ratingAverage   Decimal       @default(0) @db.Decimal(3, 2)
  ratingCount     Int           @default(0)
  status          ProductStatus @default(DRAFT)
  moderatedById   String?       @db.Uuid
  moderatedAt     DateTime?
  rejectionReason String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  seller          SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  moderatedBy     User?         @relation("ProductModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  cartItems       CartItem[]
  orderItems      OrderItem[]
  auction         Auction?
  reviews         Review[]

  @@index([sellerId, status])
  @@index([categoryId, status])
  @@index([status, type])
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventId       String    @unique @default(uuid()) @db.Uuid
  eventType     String
  aggregateType String
  aggregateId   String    @db.Uuid
  occurredAt    DateTime  @default(now())
  correlationId String    @db.Uuid
  schemaVersion Int       @default(1)
  payload       Json
  publishedAt   DateTime?
  attemptCount  Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now())
  lockedAt      DateTime?
  lockedUntil   DateTime?
  lockedBy      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([publishedAt, nextAttemptAt, occurredAt])
  @@index([lockedUntil])
}

model ProcessedEvent {
  consumerName String
  eventId      String   @db.Uuid
  processedAt  DateTime @default(now())

  @@id([consumerName, eventId])
}

model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @db.Uuid
  productId String   @db.Uuid
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([productId])
}

model Order {
  id                    String                @id @default(uuid()) @db.Uuid
  customerId            String                @db.Uuid
  status                OrderStatus           @default(NEW)
  currency              String                @db.VarChar(3)
  totalAmount           Decimal               @db.Decimal(19, 2)
  refundedAmount        Decimal               @default(0) @db.Decimal(19, 2)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  customer              User                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sellerOrders          SellerOrder[]
  checkoutIdempotencies CheckoutIdempotency[]
  refunds               Refund[]
  disputes              Dispute[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
}

model SellerOrder {
  id                 String                 @id @default(uuid()) @db.Uuid
  orderId            String                 @db.Uuid
  sellerId           String                 @db.Uuid
  status             SellerOrderStatus      @default(NEW)
  currency           String                 @db.VarChar(3)
  grossAmount        Decimal                @db.Decimal(19, 2)
  commissionRate     Decimal                @db.Decimal(7, 6)
  platformCommission Decimal                @db.Decimal(19, 2)
  sellerNet          Decimal                @db.Decimal(19, 2)
  refundedGross      Decimal                @default(0) @db.Decimal(19, 2)
  refundedCommission Decimal                @default(0) @db.Decimal(19, 2)
  refundedSellerNet  Decimal                @default(0) @db.Decimal(19, 2)
  cancelledAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  order              Order                  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seller             SellerProfile          @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  ledgerEntries      FinancialLedgerEntry[]
  refunds            Refund[]
  disputes           Dispute[]

  @@unique([orderId, sellerId])
  @@index([sellerId, status, createdAt])
  @@index([orderId, status])
}

model OrderItem {
  id                 String                 @id @default(uuid()) @db.Uuid
  sellerOrderId      String                 @db.Uuid
  productId          String                 @db.Uuid
  productTitle       String
  productImageUrl    String?
  productType        ProductType
  sellerIdSnapshot   String                 @db.Uuid
  sellerNameSnapshot String
  unitPrice          Decimal                @db.Decimal(19, 2)
  quantity           Int
  lineTotal          Decimal                @db.Decimal(19, 2)
  cancelledQuantity  Int                    @default(0)
  refundedQuantity   Int                    @default(0)
  refundedAmount     Decimal                @default(0) @db.Decimal(19, 2)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  sellerOrder        SellerOrder            @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  product            Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  ledgerEntries      FinancialLedgerEntry[]
  refunds            Refund[]
  review             Review?
  disputes           Dispute[]

  @@index([sellerOrderId])
  @@index([productId])
}

model Review {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String    @db.Uuid
  productId   String    @db.Uuid
  orderItemId String    @unique @db.Uuid
  rating      Int
  text        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  customer    User      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([customerId, productId])
  @@index([productId, createdAt])
}

model Dispute {
  id             String        @id @default(uuid()) @db.Uuid
  customerId     String        @db.Uuid
  orderId        String        @db.Uuid
  sellerOrderId  String        @db.Uuid
  orderItemId    String?       @db.Uuid
  scopeKey       String        @db.VarChar(80)
  status         DisputeStatus @default(OPEN)
  reason         String        @db.VarChar(2000)
  resolutionNote String?       @db.VarChar(2000)
  reviewedById   String?       @db.Uuid
  reviewedAt     DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customer       User          @relation("DisputeCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  reviewedBy     User?         @relation("DisputeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrder    SellerOrder   @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  orderItem      OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([customerId, scopeKey])
  @@index([customerId, createdAt])
  @@index([sellerOrderId, createdAt])
  @@index([status, createdAt])
}

model FinancialLedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  sellerOrderId  String          @db.Uuid
  orderItemId    String?         @db.Uuid
  account        LedgerAccount
  entryType      LedgerEntryType
  direction      LedgerDirection
  amount         Decimal         @db.Decimal(19, 2)
  currency       String          @db.VarChar(3)
  idempotencyKey String          @unique
  occurredAt     DateTime        @default(now())
  createdAt      DateTime        @default(now())
  sellerOrder    SellerOrder     @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  orderItem      OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([sellerOrderId, occurredAt])
  @@index([entryType, occurredAt])
  @@index([orderItemId])
}

model CheckoutIdempotency {
  id             String                    @id @default(uuid()) @db.Uuid
  customerId     String                    @db.Uuid
  idempotencyKey String
  requestHash    String
  status         CheckoutIdempotencyStatus @default(PROCESSING)
  orderId        String?                   @db.Uuid
  lastErrorCode  String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  completedAt    DateTime?
  customer       User                      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order          Order?                    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([customerId, idempotencyKey])
  @@unique([orderId])
  @@index([status, createdAt])
}

model Refund {
  id               String      @id @default(uuid()) @db.Uuid
  initiatedById    String      @db.Uuid
  orderId          String      @db.Uuid
  sellerOrderId    String      @db.Uuid
  orderItemId      String      @db.Uuid
  idempotencyKey   String
  requestHash      String
  quantity         Int
  amount           Decimal     @db.Decimal(19, 2)
  commissionAmount Decimal     @db.Decimal(19, 2)
  sellerNetAmount  Decimal     @db.Decimal(19, 2)
  reason           String?     @db.VarChar(500)
  createdAt        DateTime    @default(now())
  initiatedBy      User        @relation(fields: [initiatedById], references: [id], onDelete: Restrict)
  order            Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sellerOrder      SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  orderItem        OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([initiatedById, idempotencyKey])
  @@index([orderId, createdAt])
  @@index([sellerOrderId, createdAt])
  @@index([orderItemId, createdAt])
}

model Auction {
  id                      String        @id @default(uuid()) @db.Uuid
  productId               String        @unique @db.Uuid
  status                  AuctionStatus @default(SCHEDULED)
  startingPrice           Decimal       @db.Decimal(19, 2)
  minimumIncrement        Decimal       @db.Decimal(19, 2)
  startsAt                DateTime
  endsAt                  DateTime
  version                 Int           @default(0)
  currentHighestBidId     String?       @unique @db.Uuid
  winnerId                String?       @db.Uuid
  winningPrice            Decimal?      @db.Decimal(19, 2)
  winnerCheckoutExpiresAt DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  product                 Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  bids                    Bid[]         @relation("AuctionBids")
  currentHighestBid       Bid?          @relation("CurrentHighestBid", fields: [currentHighestBidId], references: [id], onDelete: SetNull)
  winner                  User?         @relation("AuctionWinner", fields: [winnerId], references: [id], onDelete: Restrict)

  @@index([status, startsAt])
  @@index([status, endsAt])
}

model Bid {
  id             String   @id @default(uuid()) @db.Uuid
  auctionId      String   @db.Uuid
  bidderId       String   @db.Uuid
  amount         Decimal  @db.Decimal(19, 2)
  idempotencyKey String
  createdAt      DateTime @default(now())
  auction        Auction  @relation("AuctionBids", fields: [auctionId], references: [id], onDelete: Restrict)
  bidder         User     @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  highestFor     Auction? @relation("CurrentHighestBid")

  @@unique([bidderId, idempotencyKey])
  @@index([auctionId, createdAt])
  @@index([auctionId, amount])
}
